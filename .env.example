# =============================================================
# Example environment file. Copy to .env and fill in real values.
#   cp .env.example .env
# =============================================================

# --- Keycloak / OpenID ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KC_HOSTNAME_URL=http://localhost:8080
KC_HOSTNAME_ADMIN_URL=http://localhost:8080

# --- Session lifetimes ---
KEYCLOAK_SSO_IDLE_SECONDS=900
KEYCLOAK_SSO_MAX_SECONDS=36000
KEYCLOAK_ACCESS_TOKEN_SECONDS=300
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS=8
# SESSION_DB_HOST=localhost
# SESSION_DB_PORT=5432
# SESSION_DB_NAME=sessions_db
# SESSION_DB_USER=postgres
# SESSION_DB_PASSWORD=change-me
# SESSION_DATABASE_CA=./certs/infra-ca.crt

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jaddar_db
POSTGRES_PORT=5432

# --- Jaddar (main) ---
JADDAR_CLIENT_ID=jaddar-client
JADDAR_CLIENT_SECRET=change-me
JADDAR_REDIRECT_URI=http://localhost:3000/callback
JADDAR_WEB_ORIGIN=http://localhost:3000
JADDAR_KEYCLOAK_AUTH_URL=http://keycloak:8080/realms/master
JADDAR_PUBLIC_AUTH_URL=http://localhost:8080/realms/master
JADDAR_REQUESTOR_AGENT_ID=JADDAR-001
JADDAR_FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:8000
REACT_APP_AUTH_URL=http://localhost:8080

# --- Requestor Manager ---
REQUESTOR_MANAGER_JWT_SECRET=change-me
REQUESTOR_MANAGER_MASTER_EMAIL=master@example.com
REQUESTOR_MANAGER_MASTER_PASSWORD=change-me
REQUESTOR_MANAGER_FRONTEND_URL=http://localhost:3002

# --- Data Holder ---
DATAHOLDER_JWT_SECRET=change-me
DATAHOLDER_ADMIN_PASSWORD=change-me
DATAHOLDER_FRONTEND_URL=http://localhost:3001
DATAHOLDER_NOTIFICATION_MAIL_ENDPOINT=
DATAHOLDER_NOTIFICATION_ENABLED=true
DATAHOLDER_NOTIFICATION_FROM_EMAIL=noreply@dataholder.local
DATAHOLDER_NOTIFICATION_FROM_NAME=RDAP Data Holder

# --- Data Holder Group Admin ---
DHG_JWT_SECRET=change-me
# Must be at least 16 characters
DHG_PROVISIONER_SECRET=change-me-16-chars

# --- Document Scanner Sidecar ---
# Shared secret between dataholder-backend and the document-scanner service.
# Must be at least 16 characters; the scanner refuses to start without it.
DOCUMENT_SCANNER_SECRET=change-me-16-chars
DHG_PARENT_DOMAIN=localhost
DHG_ADMIN_DEFAULT_PASSWORD=change-me
DHG_ADMIN_FRONTEND_URL=http://localhost:3003

# --- Email (Twilio SendGrid) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com
SENDGRID_FROM_NAME=Jaddar
PASSWORD_RESET_EXPIRY_MINUTES=60

# --- Mutual TLS between backend services ---
# Run scripts/generate-mtls-certs.sh once to generate ./certs before starting the stack.
MTLS_ENABLED=true
# Passwords for the generated PKCS12 keystores/truststore (must match what the cert script used)
MTLS_KEYSTORE_PASSWORD=changeit
MTLS_TRUSTSTORE_PASSWORD=changeit
