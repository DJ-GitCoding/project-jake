# .gitignore
# Dependencies
node_modules/
__pycache__/
*.pyc
.env
.env.production
*/rdap_uploads/
*jaddar-desktop/

# Build outputs
build/
dist/
target/
*.egg-info/

# React Router typegen output (regenerated by `react-router dev` / `react-router build`)
.react-router/

# Subdirectories
dataholder-backend/target/

# Desktop client: build output and the fallback Maven cache used by build.sh
jaddar-desktop/target/
jaddar-desktop/.m2/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker volumes
postgres_data/

# mTLS certificates (generated by scripts/generate-mtls-certs.sh — never commit)
certs/
# Infra CA staged into the dataholder-backend build context for the image cacerts bake
dataholder-backend/infra-ca.crt
dh-group-admin-backend/infra-ca.crt
requestor-manager-backend/infra-ca.crt
jaddar-backend/infra-ca.crt
.env.local
