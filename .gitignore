# .gitignore
# Dependencies
node_modules/
__pycache__/
*.pyc
.env
.env.production
*/rdap_uploads/

# Build outputs
build/
dist/
target/
*.egg-info/

# Subdirectories
dataholder-backend/target/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker volumes
postgres_data/

# mTLS certificates (generated by scripts/generate-mtls-certs.sh — never commit)
certs/
# Infra CA staged into the dataholder-backend build context for the image cacerts bake
dataholder-backend/infra-ca.crt
.env.local
